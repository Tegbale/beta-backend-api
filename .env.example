# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tegbale_db"
# Required for Prisma migrations when using a connection pooler (e.g. PgBouncer / DO Managed Postgres)
# DIRECT_URL="postgresql://user:password@localhost:5432/tegbale_db"

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

# Email (Mailgun SMTP)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-mailgun-domain
SMTP_PASS=your_mailgun_smtp_password
EMAIL_FROM=noreply@tegbale.com
SUPERADMIN_EMAIL=superadmin@tegbale.com

# File storage (Cloudinary — staging)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# File storage (DO Spaces — production)
# STORAGE_PROVIDER=spaces
# DO_SPACES_KEY=your_spaces_key
# DO_SPACES_SECRET=your_spaces_secret
# DO_SPACES_BUCKET=your_bucket_name
# DO_SPACES_REGION=nyc3