            "url": { "raw": "{{baseUrl}}/api/students/:id", "host": ["{{baseUrl}}"], "path": ["api","students",":id"], "variable": [{ "key": "id", "value": "" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Tunde\",\n  \"classroomId\": \"\"\n}",
