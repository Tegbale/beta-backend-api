          }
        },
        {
          "name": "Remove Teacher from Classroom",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/classrooms/:id/teachers/:teacherId", "host": ["{{baseUrl}}"], "path": ["api","classrooms",":id","teachers",":teacherId"], "variable": [{ "key": "id", "value": "" }, { "key": "teacherId", "value": "" }] }
          }
        },
        {
          "name": "Bulk Import Classrooms (CSV/XLSX)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/classrooms/bulk-import", "host": ["{{baseUrl}}"], "path": ["api","classrooms","bulk-import"] },
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file" }]
            }
          }
        }
      ]
    },
    {
      "name": "Students",
      "description": "SCHOOL_ADMIN, STAFF, TEACHER, SUPER_ADMIN.",
      "item": [
        {
          "name": "List Students",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/students?page=1&limit=20",
              "host": ["{{baseUrl}}"], "path": ["api","students"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "classroomId", "value": "", "disabled": true },
                { "key": "schoolId", "value": "", "disabled": true, "description": "SUPER_ADMIN filter" }
              ]
            }
          }
        },
        {
          "name": "Get Student",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/students/:id", "host": ["{{baseUrl}}"], "path": ["api","students",":id"], "variable": [{ "key": "id", "value": "" }] }
          }
