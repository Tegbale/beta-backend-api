{
  "info": {
    "name": "Tègbalé API",
    "_postman_id": "tegbale-api-collection-v1",
    "description": "Complete API reference for the Tègbalé School Management Platform.\n\n**Setup:**\n1. Set `baseUrl` to `https://tegbale-api.onrender.com` (staging) or `http://localhost:3001` (local)\n2. Call **Login** — the collection auto-saves the token to `{{token}}`\n3. All authenticated requests use `Bearer {{token}}` automatically\n\n**Roles:** SUPER_ADMIN · SCHOOL_ADMIN · STAFF · TEACHER · PARENT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://tegbale-api.onrender.com", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "schoolId", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Public — no auth required. Returns server status and timestamp."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.accessToken) {",
                  "  pm.collectionVariables.set('token', res.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@tegbale.com\",\n  \"password\": \"Admin@1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Returns `accessToken` and `refreshToken`. The test script auto-saves the access token to `{{token}}`."
          }
        },
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@school.com\",\n  \"password\": \"Password@123\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"phone\": \"+2348000000000\",\n  \"role\": \"SCHOOL_ADMIN\",\n  \"schoolId\": \"{{schoolId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Get Current User (me)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api","auth","me"] },
            "description": "Returns the authenticated user's profile."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api","auth","refresh"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"<paste_refresh_token>\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api","auth","logout"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"<paste_refresh_token>\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/change-password", "host": ["{{baseUrl}}"], "path": ["api","auth","change-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"OldPassword@123\",\n  \"newPassword\": \"NewPassword@456\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["api","auth","forgot-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@school.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Sends a password reset link to the email (if registered). Always returns 200 to avoid leaking registered emails. Link expires in 1 hour."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["api","auth","reset-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<token_from_reset_email>\",\n  \"newPassword\": \"NewPassword@123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Validates the reset token and updates the password. All active sessions are invalidated on success."
          }
        },
        {
          "name": "Verify SMTP (SUPER_ADMIN)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/verify-smtp", "host": ["{{baseUrl}}"], "path": ["api","auth","verify-smtp"] },
            "description": "Tests the SMTP connection from the server. SUPER_ADMIN only."
          }
        }
      ]
    },
    {
      "name": "Schools",
      "description": "SUPER_ADMIN only for all write operations.",
      "item": [
        {
          "name": "List Schools",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/schools?page=1&limit=20&search=",
              "host": ["{{baseUrl}}"], "path": ["api","schools"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "search", "value": "", "description": "Filter by name" }
              ]
            }
          }
        },
        {
          "name": "Get School",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/schools/:id", "host": ["{{baseUrl}}"], "path": ["api","schools",":id"], "variable": [{ "key": "id", "value": "{{schoolId}}" }] },
            "description": "Fetch a single school by ID.\n\n**Roles:** SUPER_ADMIN (any school) · SCHOOL_ADMIN (own school only — schoolId in JWT must match `:id`)"
          }
        },
        {
          "name": "Create School",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/schools", "host": ["{{baseUrl}}"], "path": ["api","schools"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laurel Nursery and Primary School\",\n  \"email\": \"admin@laurel.edu\",\n  \"phone\": \"+2348012345678\",\n  \"address\": \"12 Education Road, Lagos State\",\n  \"logo\": \"https://example.com/logo.png\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Update School",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/schools/:id", "host": ["{{baseUrl}}"], "path": ["api","schools",":id"], "variable": [{ "key": "id", "value": "{{schoolId}}" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laurel Schools\",\n  \"address\": \"Updated Address, Abuja\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Toggle School Status",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/api/schools/:id/toggle-status", "host": ["{{baseUrl}}"], "path": ["api","schools",":id","toggle-status"], "variable": [{ "key": "id", "value": "{{schoolId}}" }] }
          }
        },
        {
          "name": "Delete School",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/schools/:id", "host": ["{{baseUrl}}"], "path": ["api","schools",":id"], "variable": [{ "key": "id", "value": "{{schoolId}}" }] }
          }
        }
      ]
    },
    {
      "name": "School Requests",
      "description": "Public submission. Review/approval is SUPER_ADMIN only.",
      "item": [
        {
          "name": "Submit School Request (multipart)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/school-requests", "host": ["{{baseUrl}}"], "path": ["api","school-requests"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "schoolName", "value": "Sunrise Academy", "type": "text" },
                { "key": "contactFirstName", "value": "Amaka", "type": "text" },
                { "key": "contactLastName", "value": "Okonkwo", "type": "text" },
                { "key": "contactEmail", "value": "amaka@sunriseacademy.ng", "type": "text" },
                { "key": "contactPhone", "value": "+2348033221100", "type": "text" },
                { "key": "city", "value": "Enugu", "type": "text" },
                { "key": "country", "value": "Nigeria", "type": "text" },
                { "key": "message", "value": "We are a government-approved nursery and primary school.", "type": "text" },
                { "key": "cacDocument", "value": "", "type": "file", "description": "CAC certificate (PDF/JPG/PNG, max 10 MB)" },
                { "key": "govtDocument", "value": "", "type": "file", "description": "Government approval document (PDF/JPG/PNG, max 10 MB)" }
              ]
            },
            "description": "Public endpoint. Send as `multipart/form-data`. Both document files are required. Files are uploaded to Cloudinary."
          }
        },
        {
          "name": "List School Requests",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/school-requests?page=1&limit=20&status=PENDING",
              "host": ["{{baseUrl}}"], "path": ["api","school-requests"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "status", "value": "PENDING", "description": "PENDING | APPROVED | REJECTED (omit for all)" }
              ]
            },
            "description": "SUPER_ADMIN only."
          }
        },
        {
          "name": "Get School Request",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/school-requests/:id", "host": ["{{baseUrl}}"], "path": ["api","school-requests",":id"], "variable": [{ "key": "id", "value": "" }] },
            "description": "SUPER_ADMIN only."
          }
        },
        {
          "name": "Approve School Request",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/school-requests/:id/approve", "host": ["{{baseUrl}}"], "path": ["api","school-requests",":id","approve"], "variable": [{ "key": "id", "value": "" }] },
            "description": "SUPER_ADMIN only. Creates the school and school admin accounts, emails credentials."
          }
        },
        {
          "name": "Reject School Request",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/school-requests/:id/reject", "host": ["{{baseUrl}}"], "path": ["api","school-requests",":id","reject"], "variable": [{ "key": "id", "value": "" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Documentation provided is incomplete.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "SUPER_ADMIN only. `notes` is optional."
          }
        }
      ]
    },
    {
      "name": "Staff",
      "description": "SCHOOL_ADMIN and SUPER_ADMIN.",
      "item": [
        {
          "name": "List Staff",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/staff?page=1&limit=20&role=TEACHER&schoolId={{schoolId}}",
              "host": ["{{baseUrl}}"], "path": ["api","staff"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "role", "value": "TEACHER", "description": "SCHOOL_ADMIN | STAFF | TEACHER" },
                { "key": "schoolId", "value": "{{schoolId}}", "description": "Filter by school (SUPER_ADMIN)" },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Staff Member",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/staff/:id", "host": ["{{baseUrl}}"], "path": ["api","staff",":id"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Create Staff Member",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/staff", "host": ["{{baseUrl}}"], "path": ["api","staff"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff@school.com\",\n  \"firstName\": \"Chidi\",\n  \"lastName\": \"Okeke\",\n  \"phone\": \"+2348011223344\",\n  \"role\": \"STAFF\",\n  \"jobTitle\": \"Head Teacher\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Creates the staff account and emails temporary credentials. `role`: SCHOOL_ADMIN | STAFF | TEACHER. `jobTitle` (optional): free-form label e.g. 'Counsellor', 'Head Teacher', 'School Nurse'. SCHOOL_ADMIN callers cannot set role=SCHOOL_ADMIN (returns 403)."
          }
        },
        {
          "name": "Update Staff Member",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/staff/:id", "host": ["{{baseUrl}}"], "path": ["api","staff",":id"], "variable": [{ "key": "id", "value": "" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Chidi\",\n  \"lastName\": \"Nwosu\",\n  \"phone\": \"+2348099887766\",\n  \"jobTitle\": \"School Nurse\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Toggle Staff Status",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/api/staff/:id/toggle-status", "host": ["{{baseUrl}}"], "path": ["api","staff",":id","toggle-status"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Delete Staff Member",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/staff/:id", "host": ["{{baseUrl}}"], "path": ["api","staff",":id"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Bulk Import Staff (CSV/XLSX)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/staff/bulk-import", "host": ["{{baseUrl}}"], "path": ["api","staff","bulk-import"] },
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "description": "CSV or XLSX file" }]
            }
          }
        }
      ]
    },
    {
      "name": "Classrooms",
      "description": "SCHOOL_ADMIN, STAFF, and SUPER_ADMIN.",
      "item": [
        {
          "name": "List Classrooms",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/classrooms?page=1&limit=20",
              "host": ["{{baseUrl}}"], "path": ["api","classrooms"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Classroom",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/classrooms/:id", "host": ["{{baseUrl}}"], "path": ["api","classrooms",":id"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Create Classroom",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/classrooms", "host": ["{{baseUrl}}"], "path": ["api","classrooms"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Primary 3A\",\n  \"level\": \"Primary 3\",\n  \"schoolId\": \"{{schoolId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Update Classroom",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/classrooms/:id", "host": ["{{baseUrl}}"], "path": ["api","classrooms",":id"], "variable": [{ "key": "id", "value": "" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Primary 3B\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Delete Classroom",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/classrooms/:id", "host": ["{{baseUrl}}"], "path": ["api","classrooms",":id"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Assign Teacher to Classroom",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/classrooms/:id/teachers", "host": ["{{baseUrl}}"], "path": ["api","classrooms",":id","teachers"], "variable": [{ "key": "id", "value": "" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacherId\": \"<teacher_user_id>\"\n}",
              "options": { "raw": { "language": "json" } }
