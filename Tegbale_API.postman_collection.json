            }
          }
        },
        {
          "name": "Assign Student to Classroom",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/students/:id/classroom", "host": ["{{baseUrl}}"], "path": ["api","students",":id","classroom"], "variable": [{ "key": "id", "value": "" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"classroomId\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Delete Student",
          "request": {
            "method": "DELETE",
